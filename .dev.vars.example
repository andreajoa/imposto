STRIPE_PRICE_ABERTURA_EMPRESA=price_xxxxxxxxxxxxxxxxxxxxx

# Optional: when the second PDF is hosted at a stable URL, configure it here.
DOWNLOAD_ABERTURA_EMPRESA_URL=/abertura-de-empresa-nos-eua.pdf
